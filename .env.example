# ============================================================
# ad_monitor 环境变量模板
# 用法：
#   容器/Compose：cp .env.example .env（Dockerfile 与 docker-compose.yml 均引用 .env）
#   本地开发：    .env 已被 base.py load_dotenv 加载，改动前请先备份
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥！
# 密钥生成：python -c "import secrets; print(secrets.token_hex(48))"
# ============================================================

# ── 密钥（生产必改，均 >= 32 字节）──
SECRET_KEY=f55d2abd998298009f8fd0476051a09876c06d709311bee3767c0fcd5b69beb9fc3a6a99d4f114e4e35ed9bb6dac35a9
# SIMPLE_JWT 签名密钥（独立于 SECRET_KEY，SimpleJWT 签发/校验 Token 使用）
JWT_SIGNING_KEY=81555590ea80b0b0785439092f376dd18f16d896c120275a6bb80355217fe649bdd2216baebbb96641636849671bfb5a

# ── 运行开关 ──
DEBUG=false
# 逗号分隔，如 www.yidingdong.net,test.yidingdong.net
ALLOWED_HOSTS=*

# ── Celery ──
# compose 已通过 environment 注入 redis://redis:6379/0（优先级高于本文件），
# 此处仅供 docker run 直跑或本地覆盖局域网 Redis 时参考
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── 数据库（默认 SQLite；USE_POSTGRES=1 时切 Postgres，Docker / CI 自动启用）──
USE_POSTGRES=
DB_ENGINE=sqlite
DB_NAME=ad_monitor
DB_USER=ad_monitor
DB_PASSWORD=ad_monitor
DB_HOST=localhost
DB_PORT=5432

# ── CORS（生产环境覆盖，逗号分隔）──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
